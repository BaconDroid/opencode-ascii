{
  "name": "opencode-ascii",
  "version": "0.3.0",
  "description": "OpenCode v2 plugin that substitutes unicode characters with ASCII equivalents in AI responses and file edits",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "index.js"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "test:watch": "vitest",
    "verify": "tsc && tsc -p tsconfig.test.json && git diff --exit-code -- dist && vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "keywords": [
    "opencode",
    "plugin",
    "ascii",
    "unicode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d3vv3/opencode-ascii.git"
  },
  "dependencies": {
    "@opencode/plugin": "~2.0.30"
  },
  "overrides": {
    "@vitest/browser-playwright": "^5.1.0"
  }
}
